<form class="new-message-form" action="/new" method="POST">
  <h2 class="new-message-form-heading">Write new message</h2>
  <div class="message-form-item">
    <label for="messageUser">
      User:
      <input type="text" name="messageUser" id="messageUser">
    </label>
  </div>
  <div class="message-form-item">
    <label for="messageText">
      Message:
      <input type="text" name="messageText" id="messageText">
    </label>
  </div>
  <button type="submit">Submit</button>
</form>